APP_NAME=Zirve Toptan
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Europe/Istanbul

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=https://toptanperakende.online,https://www.toptanperakende.online,https://toptanperakende.168-222-180-190.nip.io

JWT_SECRET=change-me-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=14

ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# Tek VPS production: AWS/S3 kullanılmaz. Bu alanlar boş kalınca backend
# /app/uploads altındaki kalıcı Docker volume'a yazar.
AWS_REGION=eu-central-1
S3_BUCKET=
S3_PRESIGN_EXPIRES=600
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
PUBLIC_API_BASE=https://toptanperakende.online/api/v1

RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REFRESH=30/minute
RATE_LIMIT_UPLOAD=60/minute
